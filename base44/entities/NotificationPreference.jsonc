{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "userEmail": {
      "type": "string",
      "description": "User email address"
    },
    "applicationSubmitted": {
      "type": "boolean",
      "default": true,
      "description": "Notify on application submission"
    },
    "applicationStatusChange": {
      "type": "boolean",
      "default": true,
      "description": "Notify on application status updates"
    },
    "orderConfirmation": {
      "type": "boolean",
      "default": true,
      "description": "Notify on successful orders"
    },
    "orderStatusChange": {
      "type": "boolean",
      "default": true,
      "description": "Notify on order status updates"
    },
    "promotionalEmails": {
      "type": "boolean",
      "default": false,
      "description": "Receive promotional emails"
    },
    "newsletterEmails": {
      "type": "boolean",
      "default": false,
      "description": "Receive newsletter emails"
    }
  },
  "required": [
    "userEmail"
  ]
}