{
  "name": "Settings",
  "type": "object",
  "properties": {
    "settingKey": {
      "type": "string",
      "description": "Unique setting key"
    },
    "settingValue": {
      "type": "string",
      "description": "Setting value (string)"
    },
    "type": {
      "type": "string",
      "description": "Category type (e.g. api_key, branding, team_member, general)"
    },
    "key": {
      "type": "string",
      "description": "Key/name for this setting"
    },
    "value": {
      "type": "object",
      "description": "Structured value (JSON object)"
    },
    "description": {
      "type": "string",
      "description": "Setting description"
    }
  },
  "required": [
    "settingKey"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}