{
  "name": "ApplicationWorkflow",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "description": "Associated application ID"
    },
    "currentStage": {
      "type": "string",
      "enum": [
        "initial_review",
        "document_verification",
        "risk_assessment",
        "underwriting",
        "approval",
        "onboarding"
      ],
      "default": "initial_review",
      "description": "Current workflow stage"
    },
    "assignedTo": {
      "type": "string",
      "description": "Email of assigned reviewer"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Review priority"
    },
    "dueDate": {
      "type": "string",
      "format": "date-time",
      "description": "Review deadline"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked"
            ]
          },
          "assignedTo": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "completedDate": {
            "type": "string",
            "format": "date-time"
          },
          "completedBy": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Workflow tasks"
    },
    "stageHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "enteredDate": {
            "type": "string",
            "format": "date-time"
          },
          "completedDate": {
            "type": "string",
            "format": "date-time"
          },
          "assignedTo": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Stage progression history"
    },
    "checklistItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "completedBy": {
            "type": "string"
          },
          "completedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Review checklist"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "flaggedBy": {
            "type": "string"
          },
          "flaggedDate": {
            "type": "string",
            "format": "date-time"
          },
          "resolved": {
            "type": "boolean"
          }
        }
      },
      "default": [],
      "description": "Application flags and issues"
    },
    "riskScore": {
      "type": "number",
      "description": "AI-generated risk score 1-100"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Risk classification"
    },
    "estimatedCompletionDate": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated completion date"
    }
  },
  "required": [
    "applicationId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.assignedTo": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assignedTo": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}