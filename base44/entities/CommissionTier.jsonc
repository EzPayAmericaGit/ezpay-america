{
  "name": "CommissionTier",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "description": "Tier name"
    },
    "minConversions": {
      "type": "number",
      "description": "Minimum conversions to reach this tier"
    },
    "commissionRate": {
      "type": "number",
      "description": "Commission percentage for this tier"
    },
    "bonusPerConversion": {
      "type": "number",
      "default": 0,
      "description": "Flat bonus $ per conversion on top of percentage"
    },
    "description": {
      "type": "string",
      "description": "Public-facing tier description"
    },
    "perks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of tier perks shown to affiliates"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tier",
    "minConversions",
    "commissionRate"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}